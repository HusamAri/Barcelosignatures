# Public URL of this site. Installed signatures embed it in banner and click links,
# so it must be stable (a production domain, e.g. https://signatures.barcelo.com.tr).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bootstrap admins (comma separated). These addresses can sign in with the initial PIN 0000
# before an admins row exists; they are forced to set a password right after.
ADMIN_EMAILS=mm.tr@barcelo.com

# Optional. Signs the session cookie. Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
AUTH_SECRET=

# Install mails. Microsoft 365 SMTP AUTH works with a licensed mailbox.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=marketing.tr@barcelo.com
SMTP_PASS=
MAIL_FROM="Barceló Hotel Group Türkiye Marketing <marketing.tr@barcelo.com>"
MAIL_REPLY_TO=mm.tr@barcelo.com
